{
  "name": "mouse.rip",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "add-item": "bun ./scripts/add-item.js",
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "check": "bun run lint && bun run format:check && bunx tsc --noEmit",
    "dev": "next dev --turbopack",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "update": "bun run update:data && bun run update:images",
    "update:data": "bun ./scripts/update-data.js",
    "update:images": "concurrently \"bun run update:images:mice\" \"bun run update:images:items\" \"bun run update:images:meta\"",
    "update:images:mice": "bun ./scripts/update-mice-images.js",
    "update:images:items": "bun ./scripts/update-item-images.js",
    "update:images:meta": "bun ./scripts/update-meta-images.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "^1.19.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "next": "15.5.15",
    "next-view-transitions": "^0.3.5",
    "postcss": "^8.5.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.83.0"
  }
}
