{
  "name": "mouse.rip",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "add-item": "bun ./scripts/add-item.js",
    "build": "next build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "check": "bun run lint && bun run format:check && bunx tsc --noEmit && bun run test",
    "dev": "next dev --turbopack",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "test": "bun test",
    "test:e2e": "playwright test",
    "update": "bun run update:data && bun run update:images",
    "update:data": "bun ./scripts/update-data.js",
    "update:trap-effects": "bun ./scripts/update-trap-effects.js",
    "update:images": "bun ./scripts/update-images.js"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "next-view-transitions": "^0.3.5",
    "postcss": "^8.5.33",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@clack/prompts": "^1.9.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.167.0"
  }
}
